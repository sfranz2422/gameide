# Used from Phase 3 (the backend). The frontend needs none of these.
# Shared with PyIDE: same database, same Google OAuth client.
DATABASE_URL=postgresql://user:password@localhost:5432/pyide
SECRET_KEY=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma separated, no @. Empty allows anyone — not what you want in production.
ALLOWED_EMAIL_DOMAINS=
# Comma separated full addresses. An environment variable on purpose, so
# nobody can promote themselves through a hole in the app.
TEACHER_EMAILS=
