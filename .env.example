# The server (backend/app.py). The editor on its own needs none of these.
# Shared with PyIDE: the same database and the same Google OAuth client.
DATABASE_URL=postgresql://user:password@host:5432/pyide
SECRET_KEY=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma separated, no @. Empty allows anyone — not what you want in production.
ALLOWED_EMAIL_DOMAINS=
# Comma separated full addresses. An environment variable on purpose, so
# nobody can promote themselves through a hole in the app.
TEACHER_EMAILS=

# Local development only. Sign in without Google at /dev/login?email=...
# Ignored whenever DATABASE_URL is set.
GAMEIDE_DEV_LOGIN=1
